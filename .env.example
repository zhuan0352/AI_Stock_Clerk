# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Stripe TEST-mode secret key (https://dashboard.stripe.com/test/apikeys).
# Without it, checkout is simulated. Live keys are ignored.
STRIPE_SECRET_KEY=
# Optional: signing secret from `stripe listen --forward-to localhost:8000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# Optional overrides
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_THINKING_LEVEL=medium
# GEMINI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
